<Window x:Class="TicTacToe.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Крестики-нолики — учебный пример ADO.NET"
        Height="680" Width="540"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Режим новой игры:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="230"
                      ItemsSource="{Binding Modes}"
                      SelectedItem="{Binding SelectedMode}"
                      DisplayMemberPath="Display" />
            <Button Content="Новая игра"
                    Command="{Binding NewGameCommand}"
                    Margin="12,0,0,0" Padding="12,4" />
            <Button Content="Прервать"
                    Command="{Binding AbortCommand}"
                    Margin="8,0,0,0" Padding="12,4" />
        </StackPanel>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Cells}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" Rows="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="110" Height="110" Margin="4"
                            FontSize="48" FontWeight="SemiBold"
                            Content="{Binding Display}"
                            IsEnabled="{Binding IsEnabled}"
                            Command="{Binding DataContext.CellCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Index}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusText}"
                   FontSize="15"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap" />

        <Expander Grid.Row="3" Header="История сессий" Margin="0,12,0,0" IsExpanded="False">
            <ListBox ItemsSource="{Binding History}" Height="150" Margin="0,8,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontFamily="Consolas" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Expander>
    </Grid>
</Window>
